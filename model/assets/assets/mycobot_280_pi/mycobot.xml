<mujoco model="firefighter">
  <compiler angle="radian"/>

   <default>
    <default class="mycobot" >
      <geom type="mesh"/>
      <joint axis="0 0 1" damping="1" armature="0.1"/>
      <general gaintype="fixed" biastype="affine" gainprm="2000" biasprm="0 -2000 -200"/>
      <default class="size1">
        <general forcerange="-50 50"/>
      </default>
      <default class="size2">
        <general forcerange="-32 32"/>
      </default>
      <default class="size3">
        <general forcerange="-20 20"/>
      </default>
      <default class="visual">
        <geom contype="0" conaffinity="0" group="2" material="white"/>
      </default>
      <default class="collision">
        <geom group="3" mass="0" density="0"/>
      </default>
      <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
    </default>
  </default>

  <asset>
    <material name="white" rgba="1 1 1 1"/>
    <material name="silver" rgba=".753 .753 .753 1"/>

    <mesh name="G_base" file="assets/mycobot_280_pi/assets/collision/G_base.stl"/>
    <mesh name="joint1" file="assets/mycobot_280_pi/assets/collision/joint1.stl"/>
    <mesh name="joint2" file="assets/mycobot_280_pi/assets/collision/joint2.stl"/>
    <mesh name="joint3" file="assets/mycobot_280_pi/assets/collision/joint3.stl"/>
    <mesh name="joint4" file="assets/mycobot_280_pi/assets/collision/joint4.stl"/>
    <mesh name="joint5" file="assets/mycobot_280_pi/assets/collision/joint5.stl"/>
    <mesh name="joint6" file="assets/mycobot_280_pi/assets/collision/joint6.stl"/>
    <mesh name="joint7" file="assets/mycobot_280_pi/assets/collision/joint7.stl"/>
  </asset>
    <worldbody>
    <body name="link_base" pos="0 0 0" childclass="mycobot">
      <!-- <geom pos="0 0 -0.03" quat="0.707105 0 0 0.707108" type="mesh" contype="0" conaffinity="0" group="1" density="0" mesh="G_base"/>
      <geom pos="0 0 -0.03" quat="0.707105 0 0 0.707108" type="mesh" mesh="G_base"/> -->
      <geom type="mesh" class="visual" mesh="joint1" mass="0.120"/>
      <geom type="mesh" class="collision" mesh="joint1"/>

      <!-- <body name="joint2" pos="0 0.005 0.13956">  à modif pour que le robot puisse tourner--> 
      <body name="joint2" pos="0 0.004 0.144"> <!-- add z offset because robot can't rotate otherwise -->
        <joint name="joint1" limited="true"  range="-3.14 3.141"/>
        <geom pos="0 0 -0.06096" quat="0.707105 0 0 -0.707108" class="visual" mesh="joint2" mass="0.120"/>
        <geom pos="0 0 -0.06096" quat="0.707105 0 0 -0.707108" class="collision" mesh="joint2"/>

        <body name="joint3" pos="0 0 -0.001" quat="0.499998 0.500002 0.5 -0.5">
          <joint name="joint2" limited="true"  range="-3.14 3.141"/>
          <geom pos="0 0 0.03256" quat="0.707105 0 -0.707108 0" class="visual" mesh="joint3" mass="0.120"/>
          <geom pos="0 0 0.03256" quat="0.707105 0 -0.707108 0" class="collision" mesh="joint3"/>

          <body name="joint4" pos="-0.1104 0 0">
            <joint name="joint3" limited="true"  range="-3.14 3.141"/>
            <geom pos="0 0 0.03056" quat="0.707105 0 -0.707108 0" class="visual" mesh="joint4" mass="0.120"/>
            <geom pos="0 0 0.03056" quat="0.707105 0 -0.707108 0" class="collision" mesh="joint4"/>

            <body name="joint5" pos="-0.096 0 0.06462" quat="0.707105 0 0 -0.707108">
              <joint name="joint4" limited="true"  range="-3.14 3.141"/>
              <geom pos="0 0 -0.03356" quat="0.499998 0.500002 -0.5 0.5" class="visual" mesh="joint5" mass="0.120"/>
              <geom pos="0 0 -0.03356" quat="0.499998 0.500002 -0.5 0.5" class="collision" mesh="joint5"/>

              <body name="joint6" pos="0 -0.07318 0" quat="0.499998 0.5 -0.5 0.500002">
                <joint name="joint5" limited="true"  range="-3.14 3.141"/>
                <geom pos="0 0 -0.038" class="visual" mesh="joint6" mass="0.120"/>
                <geom pos="0 0 -0.038" class="collision" mesh="joint6"/>

                <body name="joint6_flange" pos="0 0.0456 0" quat="0.707105 -0.707108 0 0">
                  <joint name="joint6" limited="true"  range="-3.14 3.141"/>
                  <geom pos="0 0 -0.012" class="visual" mesh="joint7" mass="0.120"/>
                  <geom pos="0 0 -0.012" class="collision" mesh="joint7"/>

                  <body name="gripper" pos="0 0 0.02" quat="1 0 0 1">
                    <body name="CAM" pos="0 0 -0.025" quat="0 -1 0 1">
                      <camera name="robot_cam" quat="0 1 0 1" pos="0 0 0"/>
                    </body>
                    <body name="gripper_lite_left" pos="0.025 0 0"  quat="0 0 -1 1">
                      <geom type="box" size="0.001 0.02 0.01" rgba=".2 .2 1 1" mass="0.0001"/>
                      <joint name="gripper_lite_left_joint" type="slide" axis="1 0 0" pos="0 0 0" damping="1"/>
                    </body>
                    <body name="gripper_lite_right" pos="-0.025 0 0"  quat="0 0 -1 1">
                      <geom type="box" size="0.001 0.02 0.01" rgba=".2 .2 1 1" mass="0.0001"/>
                      <joint name="gripper_lite_right_joint" type="slide" axis="1 0 0" pos="0 0 0" damping="1"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- forcerange="-100 100" -->

  <actuator>
    <position name="joint1" joint="joint1" ctrllimited="true" forcelimited="false" ctrlrange="-3.14 3.14159" kp="4"/> 
    <position name="joint2" joint="joint2" ctrllimited="true" forcelimited="false" ctrlrange="-3.14 3.14159" kp="4"/>
    <position name="joint3" joint="joint3" ctrllimited="true" forcelimited="false" ctrlrange="-3.14 3.14159" kp="4"/>
    <position name="joint4" joint="joint4" ctrllimited="true" forcelimited="false" ctrlrange="-3.14 3.14159" kp="4"/>
    <position name="joint5" joint="joint5" ctrllimited="true" forcelimited="false" ctrlrange="-3.14 3.14159" kp="4"/>
    <position name="joint6" joint="joint6" ctrllimited="true" forcelimited="false" ctrlrange="-3.14 3.14159" kp="4"/>

    <position name="gripper_lite_left" joint="gripper_lite_left_joint" ctrllimited="true" ctrlrange="0 0.02" kp="12"/> 
    <position name="gripper_lite_right" joint="gripper_lite_right_joint" ctrllimited="true" ctrlrange="-0.02 0" kp="12"/> 
  </actuator>

</mujoco>
